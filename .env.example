# ---------------------------------------------------------------------------
# Shared env template. Two consumers read (different subsets of) these vars:
#
#  1. Vercel app (Next.js) — dotenv loads this file; quoted values are fine.
#  2. Scan worker (systemd EnvironmentFile=/opt/wcag-score/.env) — systemd does
#     NOT strip quotes, so the worker's .env MUST use UNQUOTED values and avoid
#     shell-special characters ($, spaces, #, backslashes) in secret values.
#     `deploy/swas/provision.sh` writes the worker .env correctly for you.
# ---------------------------------------------------------------------------

# SurrealDB (cloud)
SURREAL_URL="https://your-instance.surreal.cloud"
# Auth: either a token (preferred — see src/db/index.ts) ...
SURREAL_TOKEN=""
# ... or namespace-scoped username/password (SURREAL_URL alias: SURREAL_ENDPOINT)
SURREAL_USERNAME=""
SURREAL_PASSWORD=""
SURREAL_NAMESPACE="wcag-score"
SURREAL_DATABASE="main"

# Browserless (headless Chrome for the scan worker)
BROWSERLESS_URL="ws://127.0.0.1:3000"
BROWSERLESS_TOKEN=""

# Worker tuning (all optional; production values shown)
WORKER_POLL_INTERVAL_MS="500"
WORKER_BATCH_SIZE="5"
WORKER_SCAN_CONCURRENCY="2"
WORKER_ASSESSMENT_CONCURRENCY="2"
WORKER_BROWSER_POOL_SIZE="2"
WORKER_STALE_RUNNING_MINUTES="10"
WORKER_PAGE_TIMEOUT_MS="180000"
SCAN_SETTLE_MS="300"
ENABLE_IBM_SCAN="false"
EVIDENCE_ELEMENT_LIMIT="0"
EVIDENCE_FULLPAGE_SCREENSHOT="false"
MAX_QUEUE_DEPTH=""
LOG_LEVEL="info"

# Stripe (donations + whole-site subscriptions, USD)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SITE_PRICE_USD="28"
STRIPE_PORTAL_CONFIG_ID=""

# Misc
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
