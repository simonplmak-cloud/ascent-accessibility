# SurrealDB (cloud)
SURREAL_URL="https://your-instance.surreal.cloud"
SURREAL_USERNAME=""
SURREAL_PASSWORD=""
SURREAL_NAMESPACE="wcag-score"
SURREAL_DATABASE="main"

# Browserless (headless Chrome for the scan worker)
BROWSERLESS_URL="wss://chrome.browserless.io"
BROWSERLESS_TOKEN=""

# Worker tuning (optional)
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="5"
WORKER_SCAN_CONCURRENCY="5"

# Stripe (donations + whole-site subscriptions, USD)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SITE_PRICE_USD="28"

# Misc
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
