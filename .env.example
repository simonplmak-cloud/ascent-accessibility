# ---------------------------------------------------------------------------
# Shared env template. Two consumers read (different subsets of) these vars:
#
#  1. Vercel app (Next.js) — dotenv loads this file; quoted values are fine.
#  2. Scan worker (systemd EnvironmentFile=/opt/wcag-score/.env) — systemd does
#     NOT strip quotes, so the worker's .env MUST use UNQUOTED values and avoid
#     shell-special characters ($, spaces, #, backslashes) in secret values.
#     `deploy/swas/provision.sh` writes the worker .env correctly for you.
# ---------------------------------------------------------------------------

# SurrealDB (cloud)
SURREAL_URL="https://your-instance.surreal.cloud"
# Auth: either a token (preferred — see src/db/index.ts) ...
SURREAL_TOKEN=""
# ... or namespace-scoped username/password (SURREAL_URL alias: SURREAL_ENDPOINT)
SURREAL_USERNAME=""
SURREAL_PASSWORD=""
SURREAL_NAMESPACE="wcag-score"
SURREAL_DATABASE="main"

# Browserless (headless Chrome for the scan worker)
BROWSERLESS_URL="ws://127.0.0.1:3000"
BROWSERLESS_TOKEN=""
# Optional HTTP override for the browserless /performance (site audit) endpoint.
# Defaults to BROWSERLESS_URL with ws:// -> http:// (e.g. http://127.0.0.1:3000).
BROWSERLESS_HTTP_URL=""

# Worker tuning (all optional; production values shown)
WORKER_POLL_INTERVAL_MS="500"
WORKER_BATCH_SIZE="5"
WORKER_SCAN_CONCURRENCY="4"
WORKER_ASSESSMENT_CONCURRENCY="2"
WORKER_BROWSER_POOL_SIZE="4"
WORKER_STALE_RUNNING_MINUTES="10"
WORKER_PAGE_TIMEOUT_MS="180000"
SCAN_SETTLE_MS="300"
SITE_AUDIT_TIMEOUT_MS="90000"
# Crawl politeness delay between page fetches (ms). Default 200.
CRAWL_DELAY_MS="200"
# Parallel crawl fetchers. Default 4.
CRAWL_CONCURRENCY="4"
EVIDENCE_ELEMENT_LIMIT="0"
EVIDENCE_FULLPAGE_SCREENSHOT="false"
MAX_QUEUE_DEPTH=""
LOG_LEVEL="info"

# AI needs-review triage (Qwen vision). Off by default.
ENABLE_AI_REVIEW="false"
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
AI_REVIEW_MODEL="qwen3-vl-flash"
AI_REVIEW_CONFIDENCE_THRESHOLD="0.8"
AI_REVIEW_TIMEOUT_MS="60000"

# Stripe (donations + whole-site subscriptions, USD)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SITE_PRICE_USD="28"
STRIPE_PORTAL_CONFIG_ID=""

# Misc
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Identity: Google OAuth + email verification + BYOK
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
N8N_EMAIL_WEBHOOK_URL=""
# Secret used to encrypt per-account BYOK Qwen keys (AES-256-GCM). Set in both
# Vercel (encrypt on save) and the SWAS worker .env (decrypt on use).
BYOK_ENCRYPTION_SECRET=""
# Per-account daily scan limits (whole-site bound).
SCAN_PAGE_DAILY_LIMIT="20"
SCAN_SITE_DAILY_LIMIT="3"
