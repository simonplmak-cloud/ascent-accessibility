{
  "name": "ascent-accessibility",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source web accessibility assessment platform — WCAG scoring, findings, recommendations, and PDF reports",
  "license": "AGPL-3.0",
  "homepage": "https://accessibility.ascent.partners",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonplmak-cloud/ascent-accessibility.git"
  },
  "bugs": {
    "url": "https://github.com/simonplmak-cloud/ascent-accessibility/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:live": "tsx src/db/migrate-live.ts",
    "db:migrate:conformance": "tsx src/db/migrate-conformance.ts",
    "db:migrate:auth-unification": "tsx src/db/migrate-auth-unification.ts",
    "db:set-reviewer": "tsx src/db/set-reviewer.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/worker.js --tsconfig=tsconfig.json --packages=external"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "next": "^15.1.3",
    "next-intl": "^4.0.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.5.0",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "stripe": "^22.5.0",
    "surrealdb": "^2.0.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
